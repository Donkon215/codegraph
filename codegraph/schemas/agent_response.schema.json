{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Response",
  "description": "Agent output applied by codegraph.",
  "type": "object",
  "required": ["cycle", "graph_version"],
  "properties": {
    "cycle": { "type": "integer", "minimum": 1 },
    "graph_version": { "type": "integer", "minimum": 1 },
    "intents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node", "intent"],
        "properties": {
          "node": { "type": "string" },
          "intent": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node", "action"],
        "properties": {
          "node": { "type": "string" },
          "action": {
            "type": "string",
            "enum": ["connect_call", "add_import", "remove_dead_code", "flag_for_human_review"]
          },
          "target": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "workflow_suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "source", "target"],
        "properties": {
          "type": { "type": "string", "enum": ["required_call", "forbidden_call"] },
          "source": { "type": "string" },
          "target": { "type": "string" },
          "reason": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
