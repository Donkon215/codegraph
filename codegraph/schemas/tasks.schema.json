{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tasks",
  "description": "Agent work queue generated by codegraph.",
  "type": "object",
  "required": ["cycle", "graph_version", "tasks"],
  "properties": {
    "cycle": { "type": "integer", "minimum": 1 },
    "graph_version": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task_id", "priority"],
        "properties": {
          "task_id": { "type": "string" },
          "priority": { "type": "integer", "minimum": 1 },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id"],
              "properties": {
                "id": { "type": "string" },
                "file": { "type": "string" },
                "type": { "type": "string" },
                "calls": { "type": "array", "items": { "type": "string" } },
                "called_by": { "type": "array", "items": { "type": "string" } },
                "suggested_fix": { "type": "string" },
                "missing_import": { "type": "string" },
                "dynamic_target": { "type": "string" },
                "previous_intent": { "type": "string" },
                "body_hash_changed": { "type": "boolean" },
                "reason": { "type": "string" },
                "semantic_context": { "type": "object" },
                "safety_warnings": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "violations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["source", "required_target"],
              "properties": {
                "source": { "type": "string" },
                "required_target": { "type": "string" },
                "policy_reason": { "type": "string" },
                "current_calls": { "type": "array", "items": { "type": "string" } },
                "suggested_fix": { "type": "string" },
                "suggested_fix_target": { "type": "string" },
                "affected_tests": { "type": "array", "items": { "type": "string" } },
                "test_update_required": { "type": "boolean" },
                "test_change_type": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
