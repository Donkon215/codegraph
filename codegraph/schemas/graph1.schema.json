{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Graph_1",
  "description": "Intent-metadata overlay referencing Graph_0 nodes.",
  "type": "object",
  "required": ["format_version", "nodes"],
  "properties": {
    "format_version": { "type": "integer", "minimum": 1 },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "intent": { "type": "string" },
          "layer": { "type": "integer", "minimum": 0, "maximum": 4 },
          "arch_layer": { "type": "string" },
          "intent_author": { "type": "string" },
          "intent_version": { "type": "integer", "minimum": 1 },
          "intent_timestamp": { "type": "string", "format": "date-time" },
          "tags": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
